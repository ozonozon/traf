# --- Telegram Mini App ---
# Токен бота из @BotFather. Только сервер: на фронтенд никогда не отправляется.
# Используется для проверки подписи initData, проверки подписок и ответа на /start.
TELEGRAM_BOT_TOKEN=""

# Публичный HTTPS-адрес Mini App — тот же, что указан в BotFather (/newapp).
# Используется как URL кнопки «Открыть» в приветственном сообщении бота.
# Пример: NEXT_PUBLIC_APP_URL="https://my-app.vercel.app"
NEXT_PUBLIC_APP_URL=""

# --- Сессия (подпись httpOnly-cookie с состоянием пользователя) ---
# В production обязателен. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=""

# ВАЖНО:
#  - DATABASE_URL проекту НЕ нужен: MVP не использует внешнюю БД;
#  - не создавайте NEXT_PUBLIC_* для TELEGRAM_BOT_TOKEN и AUTH_SECRET —
#    такие переменные попадают в клиентский бандл;
#  - NEXT_PUBLIC_APP_URL — не секрет (это публичный адрес приложения).


