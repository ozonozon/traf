# --- База данных (внутреннее серверное хранилище) ---
# Локально: файл SQLite. Строку читает ТОЛЬКО сервер (lib/prisma.ts), на клиент она не попадает.
DATABASE_URL="file:./prisma/dev.db"
#
# Production (Vercel): файл SQLite не сохраняется между деплоями и инстансами.
# Вариант 1 — Turso/libSQL (остаёмся на provider = "sqlite"):
#   npm i @prisma/adapter-libsql
#   DATABASE_URL="libsql://<db>.turso.io?authToken=<token>"
# Вариант 2 — PostgreSQL/Supabase (в prisma/schema.prisma сменить provider на "postgresql"):
#   npm i @prisma/adapter-pg pg
#   DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# --- Telegram Mini App ---
# Токен бота из @BotFather. Только сервер: на фронтенд никогда не отправляется.
TELEGRAM_BOT_TOKEN=""

# --- Сессия (подпись httpOnly-cookie) ---
# В production обязателен. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=""

# --- Admin API (заготовка; без значения роуты отключены) ---
ADMIN_TOKEN=""

# ВАЖНО: не создавайте NEXT_PUBLIC_* для DATABASE_URL, TELEGRAM_BOT_TOKEN,
# AUTH_SECRET, ADMIN_TOKEN и любых других секретов — такие переменные попадают
# в клиентский бандл.

