# --- База данных (PostgreSQL; production — Neon) ---
# НЕ коммитьте реальную строку подключения. В Vercel она задаётся в Environment Variables.
# Neon: используйте pooled-строку из панели Neon (в ней уже есть sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#
# Локальная разработка (Postgres в docker):
#   docker run --name voxy-postgres \
#     -e POSTGRES_USER=voxy -e POSTGRES_PASSWORD=voxy_local_password -e POSTGRES_DB=voxy \
#     -p 5433:5432 -d postgres:16
#   DATABASE_URL="postgresql://voxy:voxy_local_password@localhost:5433/voxy?schema=public"

# --- Telegram Mini App ---
# Токен бота из @BotFather. Только сервер: на фронтенд никогда не отправляется.
TELEGRAM_BOT_TOKEN=""

# --- Сессия (подпись httpOnly-cookie) ---
# В production обязателен. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=""

# --- Admin API (заготовка; без значения роуты отключены) ---
ADMIN_TOKEN=""

# ВАЖНО: не создавайте NEXT_PUBLIC_* для DATABASE_URL, TELEGRAM_BOT_TOKEN,
# AUTH_SECRET, ADMIN_TOKEN и любых других секретов — такие переменные попадают
# в клиентский бандл.

