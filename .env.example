# --- PostgreSQL (Neon) ---
# Строка подключения к базе. Читается ТОЛЬКО на сервере (lib/db.ts) и никогда не логируется.
# Neon: возьмите pooled-строку подключения (в ней уже есть sslmode=require).
# Локально: postgresql://postgres:postgres@localhost:5432/paydoearn
DATABASE_URL=""

# --- Telegram Mini App ---
# Токен бота из @BotFather. Только сервер: на фронтенд никогда не отправляется.
# Используется для проверки подписи initData, проверки подписок и ответа на /start.
TELEGRAM_BOT_TOKEN=""

# Публичный HTTPS-адрес Mini App — тот же, что указан в BotFather (/newapp).
# Используется как URL кнопки «Открыть» в приветственном сообщении бота.
# Пример: NEXT_PUBLIC_APP_URL="https://my-app.vercel.app"
NEXT_PUBLIC_APP_URL=""

# --- Сессия (подпись httpOnly-cookie с telegram id) ---
# В production обязателен. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=""

# ВАЖНО:
#  - состояние пользователя (баланс, заявки, задания, операции) хранится в PostgreSQL;
#  - не создавайте NEXT_PUBLIC_* для DATABASE_URL, TELEGRAM_BOT_TOKEN и AUTH_SECRET —
#    такие переменные попадают в клиентский бандл;
#  - NEXT_PUBLIC_APP_URL — не секрет (это публичный адрес приложения).


