# --- Telegram Mini App ---
# Токен бота из @BotFather. Только сервер: на фронтенд никогда не отправляется.
# Используется для проверки подписи initData и проверки подписок на каналы.
TELEGRAM_BOT_TOKEN=""

# --- Сессия (подпись httpOnly-cookie с состоянием пользователя) ---
# В production обязателен. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=""

# ВАЖНО:
#  - DATABASE_URL проекту НЕ нужен: MVP не использует внешнюю БД;
#  - не создавайте NEXT_PUBLIC_* для TELEGRAM_BOT_TOKEN и AUTH_SECRET —
#    такие переменные попадают в клиентский бандл.


